# Set BOTH before enabling owner login and editing in production.
# For Docker Compose, copy this file to .env (never commit actual secrets).
ADMIN_PASSWORD=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# LAN Docker deployment. HTTP works with HttpOnly, SameSite=Strict cookies.
# For later HTTPS, set this to the exact https:// URL and recreate the container.
APP_URL=http://10.0.0.16:3009
# Non-Docker storage only; Docker uses /app/data in the persistent disc-data volume.
# For local Windows use, set APP_URL=http://127.0.0.1:3000 in .env.local.
# Never commit database files or uploaded photos.
DATA_DIR=./data
